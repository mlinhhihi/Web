@model QLBanHangGauBong_65131773.Models.KHACHHANG

@{
    ViewBag.Title = "Đăng ký";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("Create", "KHACHHANGs_65131773", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.HoTen)
        @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.HoTen)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.TenTK, "Tên đăng nhập")
        @Html.TextBoxFor(m => m.TenTK, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.TenTK)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.MatKhau, "Mật khẩu")
        @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.MatKhau)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
        @Html.ValidationMessageFor(m => m.Email)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.SDT, "Số điện thoại")
        @Html.TextBoxFor(m => m.SDT, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.SDT)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.GioiTinh)
        @Html.DropDownListFor(m => m.GioiTinh, new SelectList(new[] { "Nam", "Nữ" }), "Chọn giới tính", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.GioiTinh)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.DiaChi)
        @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.DiaChi)
    </div>

    <input type="submit" value="Đăng ký" class="btn btn-primary mt-2" />
}

<div class="mt-3">
    @Html.ActionLink("Quay lại", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
