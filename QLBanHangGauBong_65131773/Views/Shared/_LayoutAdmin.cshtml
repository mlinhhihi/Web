@{
    Layout = null;
    string role = Session["UserRole"] as string;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="#">Dashboard Admin</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("IndexAdmin","Home")">Trang chủ</a>
                </li>
                @if (role == "Admin")
                {
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","NHANVIENs_65131773")">Quản lý nhân viên</a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Create","SANPHAMs_65131773")">Quản lý sản phẩm</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index","DONHANGs_65131773")">Quản lý đơn hàng</a>
                </li>
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">@ViewBag.UserName</a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item text-danger" href="@Url.Action("Logout","NHANVIENs_65131773")">Đăng xuất</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
