@{
    ViewBag.Title = "Trang Admin";
    string role = ViewBag.UserRole as string; // Admin hoặc NhanVien
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Gấu Bự Shop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <div class="container mt-4">
        <div class="alert alert-success">
            Chào mừng <strong>@ViewBag.UserName</strong>! Bạn đang đăng nhập với quyền <strong>@role</strong>.
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Nhân viên</h5>
                        <p class="card-text">Quản lý nhân viên (Admin mới xem được)</p>
                        @if (role == "Admin")
                        {
                            <a href="@Url.Action("Index","NHANVIENs_65131773")" class="btn btn-primary">Quản lý</a>
                        }
                        else
                        {
                            <button class="btn btn-secondary" disabled>Không có quyền</button>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Sản phẩm</h5>
                        <p class="card-text">Quản lý sản phẩm</p>
                        <a href="@Url.Action("Create","SANPHAMs_65131773")" class="btn btn-primary">Quản lý</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Đơn hàng</h5>
                        <p class="card-text">Quản lý đơn hàng</p>
                        <a href="@Url.Action("Index","DONHANGs_65131773")" class="btn btn-primary">Quản lý</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
