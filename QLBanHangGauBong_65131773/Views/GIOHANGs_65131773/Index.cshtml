@model IEnumerable<QLBanHangGauBong_65131773.Models.GIOHANG>

@{
    ViewBag.Title = "Giỏ Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-light" style="background-color:#FFC0CB;">
       
        <tr>
            <th>#</th>
            <th>Sản phẩm</th>
            <th>Khách hàng</th>
            <th>Số lượng</th>
            <th>Ngày thêm</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int stt = 1;
            foreach (var item in Model)
            {
                <tr>
                    <td>@stt</td>
                    <td>@item.SANPHAM?.TenSP</td>
                    <td>@item.KHACHHANG?.HoTen</td>
                    <td>@item.SoLuong</td>
                    <td>@item.NgayThem?.ToString("dd/MM/yyyy")</td>
                    <td>@String.Format("{0:N0}", item.SANPHAM?.DonGia)</td>
                    <td>@String.Format("{0:N0}", item.SoLuong * (item.SANPHAM?.DonGia ?? 0))</td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { MaKH = item.MaKH, MaSP = item.MaSP }, new { @class = "btn btn-sm btn-warning" })
                        @Html.ActionLink("Details", "Details", new { MaKH = item.MaKH, MaSP = item.MaSP }, new { @class = "btn btn-sm btn-info" })
                        @Html.ActionLink("Delete", "Delete", new { MaKH = item.MaKH, MaSP = item.MaSP }, new { @class = "btn btn-sm btn-danger" })
                    </td>
                </tr>
                stt++;
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">Không có sản phẩm trong giỏ hàng.</td>
            </tr>
        }
    </tbody>
</table>
