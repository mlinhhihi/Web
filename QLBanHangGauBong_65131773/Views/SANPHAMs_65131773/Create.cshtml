@model QLBanHangGauBong_65131773.Models.SANPHAM

@{
    ViewBag.Title = "Thêm sản phẩm";
}

<h2>Thêm sản phẩm</h2>

@using (Html.BeginForm("Create", "SANPHAMs_65131773", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            @Html.LabelFor(model => model.MaLoaiSP, "Loại sản phẩm")
            @Html.DropDownList("MaLoaiSP", (SelectList)ViewBag.MaLoaiSP, "Chọn loại", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.MaLoaiSP, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.TenSP)
            @Html.EditorFor(model => model.TenSP, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TenSP, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.Label("Ảnh sản phẩm")
            <input type="file" name="AnhSPFile" class="form-control" />
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.DonGia)
            @Html.EditorFor(model => model.DonGia, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.DonGia, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.GiaNhap)
            @Html.EditorFor(model => model.GiaNhap, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.GiaNhap, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.SoLuongTon)
            @Html.EditorFor(model => model.SoLuongTon, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.SoLuongTon, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary">Thêm sản phẩm</button>
        @Html.ActionLink("Hủy", "Index", null, new { @class = "btn btn-secondary ms-2" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
