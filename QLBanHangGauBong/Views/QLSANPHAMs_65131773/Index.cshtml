@model IEnumerable<QLBanHangGauBong_65131773.Models.SANPHAM>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="mb-3">Quản lý sản phẩm</h2>

<p>
    @Html.ActionLink("➕ Thêm sản phẩm", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-hover text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>Tên SP</th>
            <th>Ảnh</th>
            <th>Giá bán</th>
            <th>Giá nhập</th>
            <th>Tồn kho</th>
            <th>Loại</th>
            <th width="180">Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-start">@item.TenSP</td>

                <td>
                    <img src="~/Content/Images/@item.AnhSP"
                         width="70" height="70"
                         class="img-thumbnail" />
                </td>

                <td>
                    @String.Format("{0:N0} đ", item.DonGia)
                </td>

                <td>
                    @String.Format("{0:N0} đ", item.GiaNhap)
                </td>

                <td>@item.SoLuongTon</td>

                <td>@item.LOAISP?.TenLoaiSP</td>

                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.MaSP },
                        new { @class = "btn btn-warning btn-sm" })

                    @Html.ActionLink("Chi tiết", "Details", new { id = item.MaSP },
                        new { @class = "btn btn-info btn-sm mx-1" })

                    @Html.ActionLink("Xóa", "Delete", new { id = item.MaSP },
                        new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
