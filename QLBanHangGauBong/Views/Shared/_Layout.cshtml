<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Gấu Bự Shop</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


    <style>
        body {
            background-color: #fff7fb;
            padding-top: 40px;
        }

        /* NAVBAR */
        .navbar {
            background-color: #ff69b4 !important;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 22px;
            color: white !important;
        }

        .nav-link {
            color: white !important;
            font-weight: 500;
            margin-right: 10px;
        }

            .nav-link:hover {
                color: #fffacd !important;
            }

        .navbar .btn-search {
            background-color: white;
            border-radius: 20px;
            padding: 5px 12px;
        }

        /* DROPDOWN */
        .dropdown-menu {
            border-radius: 12px;
        }

        .dropdown-item:hover {
            background-color: #ffe4f0;
        }

        /* FOOTER */
        footer {
            background-color: #ff69b4;
            color: white;
        }
    </style>
</head>

<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow fixed-top">
        <div class="container">

            <!-- LOGO -->
            @Html.ActionLink("🐻 GẤU BỰ SHOP", "Index", "Home", null,
                new { @class = "navbar-brand" })

            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- MENU LEFT -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        @Html.ActionLink("Sản phẩm", "Index", "SANPHAMs_65131773",
                            null, new { @class = "nav-link" })
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="@Url.Action("Index", "Home")" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Trang chủ
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="#gioi-thieu">Giới thiệu</a></li>
                            <li><a class="dropdown-item" href="#lien-he">Liên hệ</a></li>
                        </ul>
                    </li>
                </ul>

                <!-- SEARCH -->
                <form class="d-flex me-3" method="get"
                      action="@Url.Action("Search", "SANPHAMs_65131773")">
                    <input class="form-control me-2 rounded-pill"
                           type="search"
                           name="query"
                           placeholder="Tìm gấu bông...">
                    <button class="btn btn-light rounded-pill" type="submit">🔍</button>
                </form>

                <!-- USER MENU -->
                <ul class="navbar-nav">
                    @{
                        var kh = Session["KhachHang"] as QLBanHangGauBong_65131773.Models.KHACHHANG;
                    }

                    @if (kh == null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("DangNhap", "KHACHHANGs_65131773")">Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("DangKy", "KHACHHANGs_65131773")">Đăng ký</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "GIOHANGs_65131773")">🛒 Giỏ hàng</a>
                        </li>

                        <!-- Dropdown User -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                👤 @kh.HoTen
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("ThongTinKH", "KHACHHANGs_65131773")">👤 Thông tin cá nhân</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("LSDonMua", "KHACHHANGs_65131773")">📦 Lịch sử đơn hàng</a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="@Url.Action("DangXuat", "KHACHHANGs_65131773")">🚪 Đăng xuất</a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>

                </ul>
            </div>
        </div>
    </nav>

    <!-- BODY -->
    <div class="container mt-4 body-content">
        @RenderBody()
        <hr />
        <footer class="text-center py-3 rounded">
            <p>&copy; @DateTime.Now.Year - Gấu Bự Shop</p>
        </footer>
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>
